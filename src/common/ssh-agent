# Make sure an SSH agent is reachable, so git/ssh (and dev containers, which
# forward the host agent) can use your keys.
# - An agent that already answers (macOS launchd, a forwarded agent in an SSH
#   session or a container) is kept as is.
# - Otherwise one agent per machine is started on a fixed socket and reused by
#   every shell (WSL and Linux have no agent by default).
# Keys are added on first use by `AddKeysToAgent yes` in src/ssh/config.
if command -v ssh-agent >/dev/null 2>&1; then
	ssh-add -l >/dev/null 2>&1
	if [ $? -eq 2 ]; then
		export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
		ssh-add -l >/dev/null 2>&1
		if [ $? -eq 2 ]; then
			rm -f "$SSH_AUTH_SOCK"
			eval "$(ssh-agent -s -a "$SSH_AUTH_SOCK")" >/dev/null
		fi
	fi
fi
