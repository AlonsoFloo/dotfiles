{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "whitelist": [
        "nvidia/nemotron-3-ultra-550b-a55b:free"
      ],
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {}
      },
      "options": {
        "maxRetries": 10,
        "retryDelay": 5000
      }
    }
  },
  "disabled_providers": [
    "openai",
    "gemini",
    "anthropic",
    "google",
    "opencode"
  ],
  "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
  "share": "disabled",
  "autoCommit": false,
  "snapshots": true,
  "max_read_size": 100000,
  "max_line_length": 2000,
  "auto_resize": true,
  "max_width": 1080,
  "max_height": 1920,
  "max_base64_bytes": 2000000,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "apm_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".cache/**",
      ".gradle/**",
      "app/build/**",
      "Pods/**",
      "DerivedData/**",
      ".swiftpm/**"
    ]
  },
  "permission": {
    "read": {
      "*.env": "deny",
      "**/*.env.*": "deny",
      "secrets/*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      ".git/*": "deny",
      "*.sqlite": "deny",
      "*.db": "deny",
      "**/*.tfstate": "deny",
      "**/*.tfvars": "deny",
      "**/.keystore": "deny",
      "*": "allow"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "rm -r*": "deny",
      "sudo *": "ask",
      "chown *": "deny",
      "chmod *": "deny",
      "mkfs*": "deny",
      "npm test": "allow",
      "npm test *": "allow",
      "npm run": "allow",
      "npm run *": "allow",
      "gradlew": "allow",
      "gradlew *": "allow",
      "./gradlew": "allow",
      "./gradlew *": "allow",
      "mvn": "allow",
      "mvn *": "allow",
      "make": "allow",
      "make *": "allow",
      "cargo test": "allow",
      "cargo test *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "head": "allow",
      "head *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "ls -la": "allow",
      "ls -la *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "pwd": "allow",
      "aws": "allow",
      "aws *": "allow",
      "mv *": "ask",
      "cp *": "ask",
      "rm": "ask",
      "rm *": "ask",
      "grep": "allow",
      "grep *": "allow",
      "find": "allow",
      "find *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "pre-commit": "allow",
      "pre-commit *": "allow",
      "pre-commit run": "allow",
      "pre-commit run *": "allow",
      "*": "ask"
    },
    "task": "allow",
    "external_directory": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",
    "skill": "allow",
    "lsp": "allow",
    "doom_loop": "ask",
    "mymcp_*": "ask"
  }
}
