{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "openrouter": {
      "whitelist": [
        "nvidia/nemotron-3-ultra-550b-a55b:free"
      ],
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {}
      },
      "options": {
        "maxRetries": 10,
        "retryDelay": 5000
      }
    }
  },
  "disabled_providers": [
    "openai",
    "gemini",
    "anthropic",
    "google",
    "opencode"
  ],
  "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
  "autoupdate": true,
  "share": "disabled",
  "snapshots": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "apm_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".cache/**",
      ".gradle/**",
      "app/build/**",
      "Pods/**",
      "DerivedData/**",
      ".swiftpm/**"
    ]
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 100000
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 1080,
      "max_height": 1920,
      "max_base64_bytes": 2000000
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "secrets/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.keystore",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.tfstate",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.tfvars",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".git/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tree *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm test *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gradlew *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "./gradlew *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "mvn *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "make *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo test *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pre-commit *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "mv *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "cp *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -r*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "chown *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "chmod *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "mkfs*",
      "effect": "deny"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "lsp",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "codesearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "codesearch": "allow",
  "todowrite": "allow",
  "todoread": "allow",
  "doom_loop": "ask"
}
