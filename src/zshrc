# Init dotfiles zsh/bash
export DOTFILES_REPO=$HOME/dotfiles
export DOTFILES=$HOME/dotfiles/src
# Read by the dev container Feature (features/src/dotfiles) to forward untracked/ into containers
export DOTFILES_UNTRACKED=$HOME/dotfiles/untracked
[ -r $DOTFILES/init ] && [ -f $DOTFILES/init ] && source $DOTFILES/init
